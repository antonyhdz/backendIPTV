PATZI_ADMIN_USER=admin
PATZI_ADMIN_PASSWORD=change-this-password
PATZI_JWT_SECRET=replace-with-at-least-32-random-characters
PATZI_TOKEN_MINUTES=30
PATZI_CLIENT_SESSION_DAYS=30
PATZI_PANEL_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Optional: leave MONGODB_URI empty to use SQLite
MONGODB_URI=
MONGODB_DB_NAME=patzi_iptv

# Optional paths; defaults are under the repository root
# PATZI_DATABASE_PATH=data/patzi.db
# PATZI_BACKUP_DIR=data/backups
