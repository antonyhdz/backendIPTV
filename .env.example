MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/?retryWrites=true&w=majority
MONGODB_DB_NAME=patzi_iptv

# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_EXPIRATION_MINUTES=15
JWT_ISSUER=patzi-iptv-api

INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace-with-a-unique-password-at-least-12-characters

# Comma-separated origins for the web panel. Leave empty for native apps only.
ALLOWED_ORIGINS=
